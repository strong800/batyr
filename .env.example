# Скопируйте этот файл в .env.local и подставьте свои значения.

# --- Вход в админку (/admin) ---
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="смените-этот-пароль"
# Секрет для подписи httpOnly-куки сессии. Любая случайная строка от 32 символов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- Яндекс.Карты ---
# Ключ JS API. Без него на сайте показывается статичный блок со ссылкой,
# вёрстка не ломается.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=""

# --- Яндекс.Метрика ---
# Только номер счётчика, например 12345678. Пусто — счётчик не подключается.
NEXT_PUBLIC_YANDEX_METRIKA_ID=""

# --- Публичный адрес сайта, нужен для sitemap.xml и Open Graph ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
